<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0-windows7.0</TargetFramework><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../openPS4/openPS4.vbproj" /></ItemGroup>
  <!-- Legacy openPS4 code uses root-relative resource URIs, resolved against the test host. -->
  <ItemGroup>
    <Resource Include="../../openPS4/Icons/**/*" Link="Icons/%(RecursiveDir)%(Filename)%(Extension)" />
    <Resource Include="../../openPS4/Sounds/**/*" Link="Sounds/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
