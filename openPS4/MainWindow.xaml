<Window x:Name="OrbisMainWindow" x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:openPS4"
        mc:Ignorable="d"
        Title="openPS4 - Home" Height="1080" Width="1920" WindowStyle="None" Background="Black" ResizeMode="NoResize" Canvas.Left="0" Canvas.Top="0" 
        KeyboardNavigation.DirectionalNavigation="None" KeyboardNavigation.TabNavigation="None" KeyboardNavigation.ControlTabNavigation="None" >
    <Canvas x:Name="MainCanvas">
        <MediaElement x:Name="BackgroundMedia" Height="1080" Width="1920" Source="/System/Backgrounds/bluecircles.mp4" LoadedBehavior="Manual" UnloadedBehavior="Manual"/>
        <Image x:Name="BackgroundImage" Width="1920" Height="1080"></Image>

        <!-- Native upper menu: mouse, keyboard and controller accessible. -->
        <local:HomeMenuBar x:Name="HomeMenu" Canvas.Left="90" Canvas.Top="50" />

        <TextBlock x:Name="FunctionContext" Canvas.Left="190" Canvas.Top="110" FontSize="30" Foreground="White" Visibility="Hidden" />
        <TextBlock x:Name="FunctionDetail" Canvas.Top="375" Width="1920" TextAlignment="Center" FontSize="32" Foreground="White" Visibility="Hidden" />
        <!-- Upper Home Items -->
        <Image x:Name="WiFiIndicatorImage" Visibility="Collapsed" Height="48" Canvas.Left="1100" Canvas.Top="78" Width="48" Source="/Icons/Wifi/WiFiHigh.png"/>
        <Image x:Name="NotificationImage" Visibility="Collapsed" Height="48" Canvas.Left="96" Canvas.Top="78" Width="48" Source="/Icons/quickmenu_notifications.png"/>
        <Image x:Name="FriendsBannerImage" Visibility="Collapsed" Height="48" Canvas.Left="720" Canvas.Top="78" Width="48" Source="/Icons/quickmenu_friends.png"/>
        <Image x:Name="OnlineIndicatorImage" Visibility="Collapsed" Height="48" Canvas.Left="800" Canvas.Top="78" Width="48" Source="/Icons/online.png"/>
        <Image x:Name="BatteryIndicatorImage" Visibility="Collapsed" Height="48" Canvas.Left="1500" Canvas.Top="78" Width="48" Source="/Icons/Battery/BatteryFull.png"/>
        <TextBlock x:Name="NotificationBannerTextBlock" Visibility="Collapsed" Text="openPS4 Beta" Canvas.Left="150" Canvas.Top="82" FontFamily="SST Light, Segoe UI Light" Foreground="White" FontSize="30">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="4"/>
            </TextBlock.Effect>
        </TextBlock>
        <TextBlock x:Name="UsernameTextBlock" Visibility="Collapsed" Text="SvenGDK" Canvas.Left="855" Canvas.Top="82" FontFamily="SST Light, Segoe UI Light" Foreground="White" FontSize="30">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="4"/>
            </TextBlock.Effect>
        </TextBlock>
        <TextBlock x:Name="SystemClock" Text="00:00" Canvas.Left="1726" Canvas.Top="82" FontFamily="SST Light, Segoe UI Light" Foreground="White" FontSize="30">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="4"/>
            </TextBlock.Effect>
        </TextBlock>
        <TextBlock x:Name="BatteryPercentageTextBlock" Visibility="Collapsed" Text="100%" Canvas.Left="1553" Canvas.Top="86" FontFamily="SST Light, Segoe UI Light" Foreground="White" FontSize="24">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="4"/>
            </TextBlock.Effect>
        </TextBlock>
        <TextBlock x:Name="WiFiNetworkNameStrenghtTextBlock" Visibility="Collapsed" Text="WirelessLAN - 100%" Canvas.Left="1160" Canvas.Top="86" FontFamily="SST Light, Segoe UI Light" Foreground="White" FontSize="24" Width="330">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="4"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- Home Menu Apps -->
        <Rectangle x:Name="StartRect" Fill="Black" Width="330" Height="72" Canvas.Top="539" Visibility="Hidden" Opacity="0.7" Canvas.Left="285"></Rectangle>
        <Border x:Name="SelectedAppBorder" BorderBrush="White" BorderThickness="3" Height="175" Canvas.Left="455" Canvas.Top="204" Width="175">
            
        </Border>
        <Image x:Name="App1" Height="165" Width="165" Focusable="True" FocusVisualStyle="{x:Null}" Canvas.Left="461" Canvas.Top="209" Source="/Icons/Twitter.png" />
        <Image x:Name="App2" Height="150" Width="150" Focusable="True" FocusVisualStyle="{x:Null}" Canvas.Left="631" Canvas.Top="209" Source="/Icons/Browser.png" />
        <Image x:Name="App3" Height="150" Width="150" Focusable="True" FocusVisualStyle="{x:Null}" Canvas.Left="786" Canvas.Top="209" Source="/Icons/gallery.png" />
        <Image x:Name="App4" Height="150" Width="150" Focusable="True" FocusVisualStyle="{x:Null}" Canvas.Left="941" Canvas.Top="209" Source="/Icons/Library.png" />
        <Image x:Name="App5" Height="150" Width="150" Focusable="True" FocusVisualStyle="{x:Null}" Canvas.Left="1096" Canvas.Top="209" Source="/Icons/Explorer.png" />
        <Image x:Name="App6" Height="150" Width="150" Focusable="True" FocusVisualStyle="{x:Null}" Canvas.Left="1251" Canvas.Top="209" Source="/Icons/Settings.png" />
        <Image x:Name="App7" Height="150" Width="150" Focusable="True" FocusVisualStyle="{x:Null}" Canvas.Left="1406" Canvas.Top="209" Source="/Icons/OrbisUpdate.png" />
        <TextBlock x:Name="AppTitle" FontFamily="SST Light, Segoe UI Light" FontSize="60" Foreground="White" Canvas.Left="635" Canvas.Top="533" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{x:Null}" Visibility="Hidden">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="1"/>
            </TextBlock.Effect>
        </TextBlock>
        <TextBlock x:Name="AppStartLabel" Text="Start" Canvas.Left="290" Canvas.Top="550" Width="325" FontFamily="SST Light, Segoe UI Light" Foreground="White" FontSize="32" Visibility="Hidden" TextAlignment="Center">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="4"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- Hidden Disc App -->
        <Image x:Name="DiscApp" Height="200" Width="200" Focusable="True" FocusVisualStyle="{x:Null}" Canvas.Left="248" Canvas.Top="209" Source="/Icons/Media-DVD-icon.png" Visibility="Hidden" />
        
        <Rectangle x:Name="RightMenu" Height="1080" Canvas.Left="1925" Stroke="White" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="1,2" StartPoint="0.5,2" Opacity="0.795">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FF151515" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Button x:Name="SettingButton3" Content="Setting3" Canvas.Left="1925" Canvas.Top="332" Width="450" Height="70" FontSize="30" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="White" BorderThickness="4" FontFamily="SST Light, Segoe UI Light" HorizontalContentAlignment="Left" Padding="15,1,1,8" FocusVisualStyle="{x:Null}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="True">
            <Button.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="4"/>
            </Button.Effect>
        </Button>
        <Button x:Name="SettingButton2" Content="Setting2" Canvas.Left="1925" Canvas.Top="262" Width="450" Height="70" FontSize="30" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="White" BorderThickness="4" FontFamily="SST Light, Segoe UI Light" HorizontalContentAlignment="Left" Padding="15,1,1,8" FocusVisualStyle="{x:Null}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="True">
            <Button.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="4"/>
            </Button.Effect>
        </Button>
        <Button x:Name="SettingButton1" Content="Setting1" Canvas.Left="1925" Canvas.Top="192" Width="450" Height="70" FontSize="30" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="White" BorderThickness="3,3,3,3" FontFamily="SST Light, Segoe UI Light" HorizontalContentAlignment="Left" Padding="15,1,1,8" FocusVisualStyle="{x:Null}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="True">
            <Button.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="4"/>
            </Button.Effect>
        </Button>
    </Canvas>
</Window>
